# Python virtual environments
.venv/
venv/
env/

# Python cache and compiled files
__pycache__/
*.py[cod]
*.pyo

# Environment variables and secrets
.env
.env.*
!.env.example

# Operating system and editor files
.DS_Store
Thumbs.db
.vscode/

# Raw customer data: keep private by default
data/raw/*
!data/raw/.gitkeep

# Processed data: exclude generated datasets
data/processed/*
!data/processed/.gitkeep

# Model artifacts: ignore by default, but include the model
models/*
!models/.gitkeep
!models/churn_model.joblib

# Keep reports/figures tracked because the dashboard uses saved charts.
# Keep reports/feature_analysis/ tracked because the dashboard uses
# feature_importance.csv and feature_importance.png.

# Temporary files
*.tmp
*.log